# ============================================
# CONFIGURATION - Copier vers .env et modifier
# ============================================

# Général
TZ=Europe/Paris

# ============================================
# IPX800 V3 - Contrôle des lumières
# ============================================
IPX800_HOST=192.168.1.100
IPX800_USER=admin
IPX800_PASSWORD=votre_mot_de_passe

# ============================================
# TUYA (pour modules Loratap)
# ============================================
# Ces identifiants ne sont PAS ceux de l'app Smart Life
# Ils sont optionnels - l'intégration se fait via l'interface web
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_HOST=192.168.1.101

# ============================================
# CLOUDFLARE TUNNEL (accès distant - gratuit)
# ============================================
# Obtenir sur https://dash.cloudflare.com/
# Laisser vide si vous utilisez Nabu Casa
CLOUDFLARE_TOKEN=

# ============================================
# MQTT (optionnel)
# ============================================
MQTT_USER=homeassistant
MQTT_PASSWORD=changeme_mot_de_passe_securise

# ============================================
# NABU CASA (accès distant - payant)
# ============================================
# Configuration dans Home Assistant directement
# https://www.nabucasa.com/
# 6.50€/mois
