# Copier en .env (jamais commité)

# Jeton d'accès longue durée Home Assistant utilisé par le portail tablette
# (Profil > Sécurité > Jetons d'accès longue durée)
HA_TOKEN=

# Optionnel
HA_URL=http://127.0.0.1:8123
PORTAIL_PORT=8124
# Codes de chiffrement des images EZVIZ, par entité (JSON sur une ligne) — jamais dans git
EZVIZ_CODES={"image.salon_derniere_image_du_mouvement": "XXXXXX", "image.garage_derniere_image_du_mouvement": "XXXXXX"}

# Pont Matter (Google Home Mini) — voir docs/MATTER.md
# Le pont utilise HA_TOKEN ci-dessus.
# Accès à l'interface d'admin du pont (http://<serveur>:8482). Sans mot de passe, elle reste ouverte.
MATTER_ADMIN_USER=admin
MATTER_ADMIN_PASSWORD=
MATTER_IP_WHITELIST=192.168.1.0/24
